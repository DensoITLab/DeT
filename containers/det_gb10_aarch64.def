Bootstrap: docker
From: nvcr.io/nvidia/pytorch:26.06-py3

%labels
    Author DeT
    Description "DeT/JamMa runtime for NVIDIA GB10 / DGX Spark aarch64"

%environment
    export NVIDIA_VISIBLE_DEVICES=all
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Asia/Tokyo
    export PYTHONUNBUFFERED=1
    export PYTHONNOUSERSITE=1
    export MPLBACKEND=Agg
    export CUDA_HOME=/usr/local/cuda
    export FORCE_CUDA=1
    export MAX_JOBS="${MAX_JOBS:-4}"
    export CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-4}"
    export TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST:-12.1a}"
    export NVCC_GENCODE="${NVCC_GENCODE:---gencode=arch=compute_121,code=sm_121}"

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    export TZ=Asia/Tokyo
    ln -fs /usr/share/zoneinfo/Asia/Tokyo /etc/localtime
    echo "Asia/Tokyo" > /etc/timezone

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential \
        cmake \
        curl \
        ffmpeg \
        git \
        jq \
        libeigen3-dev \
        libgl1 \
        libglib2.0-0 \
        libopencv-dev \
        libsm6 \
        libxext6 \
        libxrender1 \
        ninja-build \
        pkg-config \
        tzdata \
        vim
    rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir --upgrade pip setuptools wheel packaging ninja

    # Keep the CUDA-enabled, arm64 PyTorch stack provided by the NGC image.
    python -m pip install --no-cache-dir \
        "numpy>=1.26,<2.0" \
        "opencv-python-headless>=4.9,<4.11" \
        "pytorch-lightning==1.9.5" \
        "torchmetrics>=0.7.0,<1.0" \
        "lightning-utilities>=0.11,<1.0" \
        "yacs==0.1.8" \
        "loguru>=0.7" \
        "einops>=0.8" \
        "kornia>=0.7,<0.8" \
        "timm>=1.0,<2.0" \
        "thop==0.1.1.post2209072238" \
        "h5py>=3.11" \
        "matplotlib>=3.8,<3.10" \
        "scipy>=1.12,<1.15" \
        "scikit-image>=0.22,<0.25" \
        "albumentations>=1.4,<2.0" \
        "imageio>=2.35" \
        "pillow>=10" \
        "tqdm>=4.67" \
        "poselib>=2.0.4" \
        "schema>=0.7" \
        "shortuuid>=1.0" \
        "jsmin>=3.0"

    ARCH="$(uname -m)"
    if [ "${ARCH}" = "aarch64" ] || [ "${ARCH}" = "arm64" ]; then
        export TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST:-12.1a}"
        export NVCC_GENCODE="${NVCC_GENCODE:---gencode=arch=compute_121,code=sm_121}"
    fi
    export FORCE_CUDA=1
    export MAX_JOBS="${MAX_JOBS:-4}"
    export CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-${MAX_JOBS}}"

    python -m pip install --no-cache-dir --no-build-isolation "causal-conv1d>=1.5.0"
    python -m pip install --no-cache-dir --no-build-isolation "mamba-ssm==2.3.2.post1"

    python - <<'PY'
import cv2
import h5py
import kornia
import numpy
import poselib
import pytorch_lightning as pl
import torch
from mamba_ssm import Mamba

print("torch", torch.__version__, "cuda", torch.version.cuda)
print("cuda_arch_list", getattr(torch.cuda, "get_arch_list", lambda: [])())
print("opencv", cv2.__version__)
print("numpy", numpy.__version__)
print("pytorch_lightning", pl.__version__)
print("mamba", Mamba)
PY

%runscript
    export PYTHONPATH="${PWD}:${PYTHONPATH:-}"
    exec "$@"

%test
    python - <<'PY'
import cv2
import pytorch_lightning as pl
import torch
from mamba_ssm import Mamba

print("torch", torch.__version__, "cuda", torch.version.cuda)
print("cuda_available", torch.cuda.is_available())
print("opencv", cv2.__version__)
print("pytorch_lightning", pl.__version__)
print("mamba", Mamba)
PY

%help
    Build on GB10 / DGX Spark aarch64:
        apptainer build det-gb10.sif containers/det_gb10_aarch64.def

    Run from the repository root:
        apptainer exec --nv det-gb10.sif python demo/demo_det.py --images a.jpg b.jpg c.jpg --ckpt_path det.ckpt
        apptainer exec --nv det-gb10.sif bash scripts/reproduce_test/paper_megadepth_0015_0022.sh
